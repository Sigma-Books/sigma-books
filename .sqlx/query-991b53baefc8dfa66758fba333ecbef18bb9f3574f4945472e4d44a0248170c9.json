  "query": "\n        SELECT a.id, a.cabinet_id, a.utilisateur_id, a.role, a.actif,\n               c.nom, c.separation_taches, c.cree_le\n        FROM appartenance a\n        JOIN cabinet c ON c.id = a.cabinet_id\n        WHERE a.utilisateur_id = $1 AND a.actif\n        ORDER BY c.nom, c.id\n        ",
