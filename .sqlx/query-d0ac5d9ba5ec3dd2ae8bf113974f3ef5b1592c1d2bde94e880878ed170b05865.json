  "query": "UPDATE tache SET etat = 'en_cours', reserve_jusqua = $2, prise = $4, tentatives = tentatives + 1 WHERE id IN ( SELECT id FROM tache WHERE nature = 'notification' AND ((etat = 'en_attente' AND prochaine_tentative <= GREATEST($1::timestamptz, now())) OR (etat = 'en_cours' AND reserve_jusqua <= $1)) ORDER BY prochaine_tentative, id LIMIT $3 FOR UPDATE SKIP LOCKED) RETURNING id, cabinet_cible, dossier_cible, sujet, objet, tentatives - 1 AS \"avant!\"",
