  "query": "SELECT s.id, s.nature, s.methode, s.cree_le, s.derniere_activite, s.appareil FROM session s WHERE s.utilisateur_id = $2 AND s.revoquee_le IS NULL AND EXISTS (SELECT 1 FROM appartenance a WHERE a.cabinet_id = $1 AND a.utilisateur_id = s.utilisateur_id) ORDER BY s.cree_le DESC, s.id",
