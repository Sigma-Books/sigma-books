  "query": "\n        SELECT id, version, nom, definition, empreinte, cree_par, cree_le\n        FROM profil_releve\n        WHERE cabinet_id = $1 AND dossier_id = $2 AND id = $3\n          AND ($4::integer IS NULL OR version = $4)\n        ORDER BY version DESC\n        LIMIT 1\n        ",
