  "query": "UPDATE tache SET etat = 'en_cours', reserve_jusqua = $2, tentatives = tentatives + 1 WHERE id IN ( SELECT id FROM tache WHERE nature = 'horodatage' AND ((etat = 'en_attente' AND prochaine_tentative <= $1) OR (etat = 'en_cours' AND reserve_jusqua <= $1)) ORDER BY prochaine_tentative, id LIMIT $3 FOR UPDATE SKIP LOCKED) RETURNING id, cabinet_cible, dossier_cible AS \"dossier_cible!\", sujet, tentatives - 1 AS \"avant!\"",
