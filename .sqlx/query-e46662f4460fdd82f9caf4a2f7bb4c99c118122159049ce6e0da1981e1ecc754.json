  "query": "WITH choisies AS MATERIALIZED ( SELECT id FROM tache WHERE nature = 'horodatage' AND ((etat = 'en_attente' AND prochaine_tentative <= $1) OR (etat = 'en_cours' AND reserve_jusqua <= $1)) ORDER BY prochaine_tentative, id LIMIT $3 FOR UPDATE SKIP LOCKED) UPDATE tache SET etat = 'en_cours', reserve_jusqua = $2, prise = $4, tentatives = tache.tentatives + 1 FROM choisies WHERE tache.id = choisies.id RETURNING tache.id, tache.cabinet_cible, tache.dossier_cible AS \"dossier_cible!\", tache.sujet, tache.tentatives - 1 AS \"avant!\"",
