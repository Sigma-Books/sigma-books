  "db_name": "PostgreSQL",
  "query": "WITH choisies AS MATERIALIZED ( SELECT id FROM tache WHERE nature = 'notification' AND ((etat = 'en_attente' AND prochaine_tentative <= GREATEST($1::timestamptz, now())) OR (etat = 'en_cours' AND reserve_jusqua <= $1)) ORDER BY prochaine_tentative, id LIMIT $3 FOR UPDATE SKIP LOCKED) UPDATE tache SET etat = 'en_cours', reserve_jusqua = $2, prise = $4, tentatives = tache.tentatives + 1 FROM choisies WHERE tache.id = choisies.id RETURNING tache.id, tache.cabinet_cible, tache.dossier_cible, tache.sujet, tache.objet, tache.tentatives - 1 AS \"avant!\"",
