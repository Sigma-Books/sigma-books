# Exemple d'environnement de développement de Sigma Books (crates/api/README.md).
# Copier en `.env` (ignoré par Git) et remplacer chaque « changez-moi » par une valeur locale.
# Aucune vraie valeur ici : ce fichier est public.

# Super-utilisateur du conteneur PostgreSQL de développement (variables libpq, lues par psql et
# scripts/preparer-base.sh ; approvisionnement et tests seulement).
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changez-moi
SIGMA_PG_BASE=sigma_books

# Mots de passe des trois rôles, lus dans l'environnement par psql (\getenv) et
# scripts/preparer-base.sh (caractères sûrs dans une URL).
SIGMA_MDP_MIGRATION=changez-moi
SIGMA_MDP_APPLICATION=changez-moi
SIGMA_MDP_LECTURE_AUDIT=changez-moi

# Rôle de migration : `sqlx migrate`, `cargo sqlx prepare` et vérification des requêtes à la compilation.
DATABASE_URL=postgres://sigma_migration:changez-moi@127.0.0.1:5432/sigma_books

# Tests `tests-postgres` (cargo test --all-features).
SIGMA_TEST_ADMIN_URL=postgres://postgres:changez-moi@127.0.0.1:5432/sigma_books
SIGMA_TEST_APPLICATION_URL=postgres://sigma_application:changez-moi@127.0.0.1:5432/sigma_books

# Serveur `api` (crates/api/src/serveur/config.rs). Le binaire refuse de démarrer sans les quatre
# premières. URL du rôle APPLICATIF, jamais celle du rôle de migration.
SIGMA_ADRESSE_ECOUTE=127.0.0.1:8080
SIGMA_URL_BASE_APPLICATION=postgres://sigma_application:changez-moi@127.0.0.1:5432/sigma_books
# URL du rôle de LECTURE D'AUDIT (ADR 0014) : pool distinct, SELECT sur l'audit seulement.
SIGMA_URL_BASE_LECTURE_AUDIT=postgres://sigma_lecture_audit:changez-moi@127.0.0.1:5432/sigma_books
SIGMA_ORIGINE=http://localhost:8080
# Facultatives : interface compilée ; en-tête de confiance du mandataire inverse (L9), à ne
# définir que derrière un mandataire qui le réécrit (sinon un client le forgerait).
# SIGMA_REPERTOIRE_WEB=web/build
# SIGMA_EN_TETE_ADRESSE_CLIENT=x-forwarded-for
