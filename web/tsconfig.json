{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// Syntaxe effaçable seule : les tests s'exécutent par `node --test`, qui retire les types.
		"erasableSyntaxOnly": true,
		"types": ["$app/types", "node"]
	},
	"include": ["src", "vite.config.ts", "eslint.config.js", "prettier.config.js"]
}
